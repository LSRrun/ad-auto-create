[Unit]
Description=Ad Auto Create API (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/ad-auto-create
Environment="PATH=/root/miniconda3/envs/adcreate/bin:/usr/local/bin:/usr/bin"
ExecStart=/root/miniconda3/envs/adcreate/bin/python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
